# --- 高德 API 配置 ---
# 在高德开放平台申请的“Web服务”类型的 Key
AMAP_KEY=这里填你申请到的Key

# 城市的行政区划代码 (adcode)
# 杭州是 330100，其他城市请参考高德官方的Excel 表
CITY_CODE=330100

# --- 运行配置 ---
# 更新频率（秒），3600 代表 1 小时同步一次
INTERVAL=3600

# 天气文件存放名称（保持默认即可，千万别动别改）
WEATHER_FILE=weather.txt

# --- 记忆服务器配置 ---
# 记忆数据文件路径
MEMORIES_FILE=memories.json
# 记忆服务器监听端口
MEMORY_PORT=8080
# 记忆合并相似度阈值（0~1），超过此值的相似内容将自动合并
MERGE_THRESHOLD=0.75
